# RESTOBOOK - Variables d'environnement Docker
#
# Copiez ce fichier en .env et renseignez vos valeurs :
# cp .env.docker .env

# MYSQL - Conteneur de base de données
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_APP_USER=change_me_database_username
MYSQL_APP_PASSWORD=change_me_database_password

# BASES DE DONNÉES - Utilisé par chaque service
# DB_HOST = nom du service MySQL dans docker-compose
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=change_me_database_username
DB_USERNAME=change_me_database_password

# SPRING - Profil actif
SPRING_PROFILES_ACTIVE=prod

# CONFIG SERVICE
CONFIG_SERVICE_PORT=8085
CONFIG_SERVER_URL=http://config-service:8085
CONFIG_REPO_PATH=file:/config-repo

# EUREKA SERVICE
EUREKA_SERVICE_PORT=8761
EUREKA_SERVER_URL=http://eureka-service:8761/eureka

# GATEWAY SERVICE
GATEWAY_SERVICE_PORT=8088
CORS_ALLOWED_ORIGINS=http://localhost:3000

# AUTH SERVICE
AUTH_SERVICE_PORT=8081
# IMPORTANT : JWT_SECRET doit être une clé Base64 valide
# Exemple de clé. Générez-en une
JWT_SECRET=change_me_super_secret_jwt_key_minimum_64_characters_for_hs512_algorithm_security
ADMIN_EMAIL=change_me_admin_email
ADMIN_PASSWORD=change_me_admin_password

# SERVICES MÉTIER - Ports exposés
RESTAURANT_SERVICE_PORT=8082
BOOKING_SERVICE_PORT=8083
REVIEW_SERVICE_PORT=8084

# URLS INTER-SERVICES (réseau Docker interne)
# Utilisées pour les appels entre microservices
AUTH_SERVICE_URL=http://auth-service:8081
RESTAURANT_SERVICE_URL=http://restaurant-service:8082
BOOKING_SERVICE_URL=http://booking-service:8083
