# GATEWAY SERVICE - Variables d'environnement

# Copiez ce fichier en .env.properties et modifiez les valeurs
# cp .env.properties.example .env.properties

# Configuration du serveur
GATEWAY_SERVICE_PORT=8088

# CORS CONFIGURATION (optionnel)

# Origines autorisées pour CORS (séparées par des virgules)
# En développement : http://localhost:3000,http://localhost:4200
# En production : https://votre-domaine.com
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Méthodes HTTP autorisées
# CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS

# Headers autorisés
# CORS_ALLOWED_HEADERS=*

# Permettre les credentials (cookies, authorization headers)
# CORS_ALLOW_CREDENTIALS=true

# Configuration du serveur Eureka
EUREKA_SERVER_URL=http://localhost:8761/eureka

# Configuration des logs
# Niveaux: TRACE, DEBUG, INFO, WARN, ERROR
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SECURITY=INFO
LOG_FILE_PATH=logs/gateway-service.log
