# BOOKING SERVICE - Variables d'environnement

# Copiez ce fichier en .env et modifiez les valeurs
# cp .env.example .env

# Configuration du serveur
BOOKING_SERVICE_PORT=8083

# Configuration du serveur Eureka
EUREKA_SERVER_URL=http://localhost:8761/eureka

# Configuration de la base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=booking_db
DB_USERNAME=your_username
DB_PASSWORD=your_password

# Configuration JPA/Hibernate
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# Configuration des services
AUTH_SERVICE_URL=http://localhost:8081
RESTAURANT_SERVICE_URL=http://localhost:8082

# Configuration des réservations
BOOKING_DURATION_MINUTES=90
BOOKING_SLOT_INTERVAL_MINUTES=30
BOOKING_MAX_PARTY_SIZE=8
BOOKING_MIN_PARTY_SIZE=1
BOOKING_MAX_DAYS_ADVANCE=7
BOOKING_CANCELLATION_HOURS=2

# Configuration des logs
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SQL=DEBUG
LOG_FILE_PATH=logs/booking-service.log

# Configuration Swagger/OpenAPI
SWAGGER_ENABLED=true
