# EUREKA SERVICE - Variables d'environnement

# Copiez ce fichier en .env et modifiez les valeurs
# cp .env.example .env

# Configuration du serveur
EUREKA_SERVICE_PORT=8761

# Configuration des logs
# Niveaux: TRACE, DEBUG, INFO, WARN, ERROR
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SECURITY=INFO
LOG_FILE_PATH=logs/eureka-service.log
