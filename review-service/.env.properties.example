# REVIEW SERVICE - Variables d'environnement

# Copiez ce fichier en .env.properties et modifiez les valeurs
# cp .env.properties.example .env.properties

# Configuration du serveur
REVIEW_SERVICE_PORT=8084

# Configuration du serveur Eureka
EUREKA_SERVER_URL=http://localhost:8761/eureka

# Configuration de la base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=review_db
DB_USERNAME=your_username
DB_PASSWORD=your_password

# Configuration JPA/Hibernate
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# Configuration des services
AUTH_SERVICE_URL=http://localhost:8081
RESTAURANT_SERVICE_URL=http://localhost:8082
BOOKING_SERVICE_URL=http://localhost:8083

# Configuration des avis
REVIEW_MIN_RATING=1
REVIEW_MAX_RATING=5
REVIEW_MIN_COMMENT_LENGTH=0
REVIEW_MAX_COMMENT_LENGTH=1000

# Configuration des logs
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SQL=INFO
LOG_FILE_PATH=logs/review-service.log

# Configuration Swagger/OpenAPI
SWAGGER_ENABLED=true
